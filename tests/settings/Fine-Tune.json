{
  "stockgs-keep-top-panel": true,
  "panel-positions": {
    "*": "BOTTOM"
  },
  "panel-sizes": {
    "*": 45
  },
  "panel-lengths": {
    "*": 100
  },
  "panel-anchors": {
    "*": "MIDDLE"
  },
  "panel-element-positions": {
    "*": [
      {
        "element": "showAppsButton",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "activitiesButton",
        "visible": false,
        "position": "centered"
      },
      {
        "element": "leftBox",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "taskbar",
        "visible": true,
        "position": "centerMonitor"
      },
      {
        "element": "centerBox",
        "visible": true,
        "position": "centered"
      },
      {
        "element": "rightBox",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "dateMenu",
        "visible": true,
        "position": "stackedBR"
      },
      {
        "element": "systemMenu",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "desktopButton",
        "visible": true,
        "position": "stackedBR"
      }
    ]
  },
  "appicon-margin": 4,
  "dot-style-focused": "DASHES",
  "show-showdesktop-hover": true,
  "showdesktop-button-width": 10,
  "desktop-line-use-custom-color": true,
  "desktop-line-custom-color": "rgb(0,0,0)",
  "window-preview-size": 180,
  "context-menu-entries": [
    {
      "title": "Terminal",
      "cmd": "TERMINALSETTINGS"
    },
    {
      "title": "System monitor",
      "cmd": "omarchy-launch-or-focus-tui btop"
    },
    {
      "title": "Files",
      "cmd": "nautilus --new-window"
    }
  ],
  "tray-size": 24,
  "leftbox-size": 20,
  "tray-padding": 8,
  "leftbox-padding": 8,
  "status-icon-padding": 5,
  "animate-app-switch": false,
  "animate-window-launch": false,
  "stockgs-keep-dash": false,
  "stockgs-panelbtn-click-only": true,
  "stockgs-force-hotcorner": true
}
