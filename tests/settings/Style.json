{
  "stockgs-keep-top-panel": true,
  "panel-positions": {
    "*": "BOTTOM"
  },
  "panel-sizes": {
    "*": 45
  },
  "panel-lengths": {
    "*": 100
  },
  "panel-anchors": {
    "*": "MIDDLE"
  },
  "panel-element-positions": {
    "*": [
      {
        "element": "showAppsButton",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "activitiesButton",
        "visible": false,
        "position": "centered"
      },
      {
        "element": "leftBox",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "taskbar",
        "visible": true,
        "position": "centerMonitor"
      },
      {
        "element": "centerBox",
        "visible": true,
        "position": "centered"
      },
      {
        "element": "rightBox",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "dateMenu",
        "visible": true,
        "position": "stackedBR"
      },
      {
        "element": "systemMenu",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "desktopButton",
        "visible": true,
        "position": "stackedBR"
      }
    ]
  },
  "appicon-margin": 4,
  "dot-style-focused": "DOTS",
  "show-showdesktop-hover": true,
  "showdesktop-button-width": 10,
  "desktop-line-use-custom-color": true,
  "desktop-line-custom-color": "rgb(0,0,0)",
  "window-preview-size": 180,
  "context-menu-entries": [
    {
      "title": "Terminal",
      "cmd": "TERMINALSETTINGS"
    },
    {
      "title": "System monitor",
      "cmd": "omarchy-launch-or-focus-tui btop"
    },
    {
      "title": "Files",
      "cmd": "nautilus --new-window"
    }
  ],
  "appicon-padding": 6,
  "global-border-radius": 4,
  "appicon-style": "NORMAL",
  "animate-appicon-hover": true,
  "animate-appicon-hover-animation-type": "PLANK",
  "animate-appicon-hover-animation-duration": {
    "SIMPLE": 160,
    "RIPPLE": 130,
    "PLANK": 100
  },
  "highlight-appicon-hover": true,
  "highlight-appicon-hover-background-color": "rgba(238, 238, 236, 0.1)",
  "highlight-appicon-pressed-background-color": "rgba(238, 238, 236, 0.18)",
  "highlight-appicon-hover-border-radius": 0,
  "dot-position": "BOTTOM",
  "dot-style-unfocused": "SQUARES",
  "dot-size": 5,
  "dot-color-dominant": true,
  "dot-color-override": false,
  "dot-color-1": "#5294e2",
  "dot-color-4": "#5294e2",
  "dot-color-unfocused-different": false,
  "dot-color-unfocused-1": "#5294e2",
  "dot-color-unfocused-4": "#5294e2",
  "focus-highlight": true,
  "focus-highlight-dominant": true,
  "focus-highlight-opacity": 25,
  "trans-use-custom-bg": false,
  "trans-bg-color": "#000",
  "trans-use-custom-opacity": true,
  "trans-panel-opacity": 0.25,
  "trans-use-dynamic-opacity": true,
  "trans-dynamic-behavior": "ALL_WINDOWS",
  "trans-dynamic-distance": 20,
  "trans-dynamic-anim-target": 0.95,
  "trans-dynamic-anim-time": 300,
  "trans-use-custom-gradient": true,
  "trans-gradient-top-color": "#4060c0",
  "trans-gradient-top-opacity": 0.3,
  "trans-gradient-bottom-color": "#103060",
  "trans-gradient-bottom-opacity": 0.5,
  "trans-use-border": true,
  "trans-border-width": 3,
  "trans-border-use-custom-color": true,
  "trans-border-custom-color": "#50c0ff",
  "panel-top-bottom-margins": 12,
  "panel-side-margins": 24,
  "panel-top-bottom-padding": 0,
  "panel-side-padding": 12,
  "dot-color-2": "#5294e2",
  "dot-color-3": "#5294e2",
  "dot-color-unfocused-2": "#5294e2",
  "dot-color-unfocused-3": "#5294e2",
  "animate-appicon-hover-animation-convexity": {
    "RIPPLE": 2,
    "PLANK": 1
  },
  "animate-appicon-hover-animation-extent": {
    "RIPPLE": 4,
    "PLANK": 4
  },
  "animate-appicon-hover-animation-rotation": {
    "SIMPLE": 0,
    "RIPPLE": 10,
    "PLANK": 0
  },
  "animate-appicon-hover-animation-travel": {
    "SIMPLE": 0.3,
    "RIPPLE": 0.4,
    "PLANK": 0
  },
  "animate-appicon-hover-animation-zoom": {
    "SIMPLE": 1,
    "RIPPLE": 1.25,
    "PLANK": 2
  }
}
