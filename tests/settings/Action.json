{
  "stockgs-keep-top-panel": true,
  "panel-positions": {
    "*": "BOTTOM"
  },
  "panel-sizes": {
    "*": 45
  },
  "panel-lengths": {
    "*": 100
  },
  "panel-anchors": {
    "*": "MIDDLE"
  },
  "panel-element-positions": {
    "*": [
      {
        "element": "showAppsButton",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "activitiesButton",
        "visible": false,
        "position": "centered"
      },
      {
        "element": "leftBox",
        "visible": true,
        "position": "stackedTL"
      },
      {
        "element": "taskbar",
        "visible": true,
        "position": "centerMonitor"
      },
      {
        "element": "centerBox",
        "visible": true,
        "position": "centered"
      },
      {
        "element": "rightBox",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "dateMenu",
        "visible": true,
        "position": "stackedBR"
      },
      {
        "element": "systemMenu",
        "visible": false,
        "position": "stackedBR"
      },
      {
        "element": "desktopButton",
        "visible": true,
        "position": "stackedBR"
      }
    ]
  },
  "appicon-margin": 4,
  "dot-style-focused": "DASHES",
  "show-showdesktop-hover": true,
  "showdesktop-button-width": 10,
  "desktop-line-use-custom-color": true,
  "desktop-line-custom-color": "rgb(0,0,0)",
  "window-preview-size": 180,
  "context-menu-entries": [
    {
      "title": "Terminal",
      "cmd": "TERMINALSETTINGS"
    },
    {
      "title": "System monitor",
      "cmd": "omarchy-launch-or-focus-tui btop"
    },
    {
      "title": "Files",
      "cmd": "nautilus --new-window"
    }
  ],
  "click-action": "TOGGLE-SHOWPREVIEW",
  "shift-click-action": "QUIT",
  "middle-click-action": "LAUNCH",
  "shift-middle-click-action": "LAUNCH",
  "customize-click": true,
  "minimize-shift": true,
  "activate-single-window": true,
  "scroll-panel-action": "CHANGE_VOLUME",
  "scroll-panel-delay": 0,
  "scroll-panel-show-ws-popup": true,
  "scroll-icon-action": "CYCLE_WINDOWS",
  "scroll-icon-delay": 0,
  "hot-keys": true,
  "hotkey-prefix-text": "Super",
  "shortcut-num-keys": "BOTH",
  "app-hotkey-1": [
    "<Super>1"
  ],
  "app-shift-hotkey-1": [
    "<Shift><Super>1"
  ],
  "app-ctrl-hotkey-1": [
    "<Ctrl><Super>1"
  ],
  "hotkeys-overlay-combo": "ALWAYS",
  "overlay-timeout": 750,
  "shortcut": [
    "<Super>q"
  ],
  "shortcut-text": "<Super>q",
  "shortcut-timeout": 2000,
  "shortcut-overlay-on-secondary": false,
  "shortcut-previews": true,
  "secondarymenu-contains-appmenu": true,
  "secondarymenu-contains-showdetails": false,
  "panel-context-menu-commands": [],
  "panel-context-menu-titles": [],
